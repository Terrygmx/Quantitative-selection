# =====================================================================
# .gitignore —— 版本控制忽略规则
# 原则：只忽略「可随时删除重建的运行产物 / 本地环境 / 编辑器状态」；
#       源代码、结果文件、输入数据、文档一律纳入版本控制（见 README）。
# =====================================================================

# ---- 运行缓存（程序 --cache-dir 生成，可随时删除重建）------------------
cache/
.cache/
.cache_v2/
.westock_cache/
.westock_cache2/
.westock_cache3/
.westock_cache*/

# ---- Python 编译产物 -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ---- 虚拟环境（本项目实际用标准库即可，不强制 venv）--------------------
.venv/
venv/
env/
ENV/

# ---- 编辑器 / 操作系统状态 -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 助手工具运行状态（非项目产物）------------------------------------
.workbuddy/

# ---- 本地临时文件 ----------------------------------------------------
*.tmp
*.temp
*.log
~$*
# Local agent and index state
.codegraph/
.pi-loop.json.lock
